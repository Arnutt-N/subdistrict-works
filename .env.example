# ============================================================
# .env.example — Subdistrict Works citizen-help
# ============================================================
# 📗 วิธีใช้ไฟล์นี้ (อ่านก่อน!):
#
#   1. คัดลอกไฟล์นี้เป็น  .env.local   (สำหรับรันในเครื่อง)
#      และกรอกค่าเดียวกันใน Vercel → Settings → Environment Variables (สำหรับ production)
#
#   2. ทำตามคู่มือ DEPLOY.md ทีละขั้น แล้วมากรอกค่าในไฟล์นี้ตามหมายเลขขั้น
#      เช่น ค่าที่ได้จาก "ขั้นที่ 2" ใน DEPLOY.md → ใส่ในส่วน [2] ด้านล่าง
#
#   3. ⚠️ ลบคำว่า CHANGE_ME_... ออก แล้วแทนด้วยค่าจริงทั้งหมด
#      (ระบบจะบล็อก deploy ถ้าค่ายังขึ้นต้นด้วย CHANGE_ME_ หรือ YOUR_)
#
#   4. ห้าม commit .env.local ขึ้น GitHub (ถูก .gitignore อยู่แล้ว)
#
# ตัวแปร: 7 ตัวหลัก (ระบบตรวจสอบอัตโนมัติตอน build) + 5 ตัว SMTP สำหรับอีเมล
# รีเซ็ตรหัสผ่าน (ไม่ถูก verify ตอน build แต่ production ต้องตั้ง ไม่งั้นอีเมลไม่ส่ง)
# + MAIL_CONSOLE (เฉพาะ dev) — เครื่องหมาย ✔ = บังคับกรอก
# ============================================================


# ────────────────────────────────────────────────────────────
# [ขั้น 2] 🗄️ ฐานข้อมูล Supabase (PostgreSQL)
# ────────────────────────────────────────────────────────────
# หาได้จาก: Supabase → Project Settings → Database → Connection string → URI (Transaction / port 6543)
#
#   รูปแบบ:  postgresql://postgres.<project>:<รหัสผ่าน>@<โฮสต์>:6543/postgres
#   ตัวอย่าง: postgresql://postgres.subdistrict-works:AbCd1234@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# ⚠️ อย่าลืมแทน <รหัสผ่าน> ด้วยรหัสที่ตั้งตอนสร้าง project ใน Supabase
#
# ⚠️ production ต้องเติม ?sslmode=require ต่อท้าย ไม่งั้น `pnpm build` จะหยุดด้วย
#    ข้อความ "production ต้องบังคับ TLS" (scripts/verify-env.ts) — connection string
#    ที่คัดลอกมาจากหน้าเว็บผู้ให้บริการมักไม่มีพารามิเตอร์นี้ติดมาด้วย
#    เช่น: postgresql://user:pass@host:6543/postgres?sslmode=require
DATABASE_URL=CHANGE_ME_paste_supabase_connection_string_here

# ── สำหรับ migration/DDL (drizzle-kit) เท่านั้น — ไม่ต้องตั้งถ้าใช้ Postgres ตัวเดียว ──
# managed Postgres (Neon ฯลฯ) แยก endpoint เป็น pooled (สำหรับแอป) กับ direct (สำหรับ DDL)
# drizzle.config.ts อ่านตัวนี้ก่อน แล้วค่อย fallback ไป DATABASE_URL
# DATABASE_URL_UNPOOLED=


# ────────────────────────────────────────────────────────────
# [ขั้น 3] ⚡ Upstash Redis (สำหรับ rate limiting / ป้องกันสแปม)
# ────────────────────────────────────────────────────────────
# หาได้จาก: Upstash → เปิด Redis database ของคุณ → ดูส่วน REST API
#
#   UPSTASH_REDIS_REST_URL  → รูปแบบ https://xxxxx.upstash.io
#   UPSTASH_REDIS_REST_TOKEN → คลิกปุ่ม Copy (ต้อง ≥ 16 ตัวอักษร)
UPSTASH_REDIS_REST_URL=CHANGE_ME_https_colon_slash_slash_xxxxx_upstash_io
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME_paste_upstash_redis_rest_token


# ────────────────────────────────────────────────────────────
# [ขั้น 5] 🔐 รหัสลับที่สร้างเอง (generate ด้วย https://generate-secret.vercel.app/32)
# ────────────────────────────────────────────────────────────
# สร้างสตริงสุ่มยาว ๆ แต่ละตัวไม่ซ้ำกัน (ห้ามใช้ค่าเดียวกัน 3 ตัว)
#
#   AUTH_SECRET  → ≥ 32 ตัวอักษร (ใช้เซ็น session ของเจ้าหน้าที่)
#   CID_HMAC_KEY → ≥ 32 ตัวอักษร (เข้ารหัสเลขบัตรประชาชน / PDPA)
#   CRON_SECRET  → ≥ 16 ตัวอักษร (ยืนยันตัวตนงานอัตโนมัติ cron-job.org)
#
#   หรือถ้ามี Terminal:  openssl rand -base64 32   และ   openssl rand -hex 16
AUTH_SECRET=CHANGE_ME_paste_32plus_random_chars
CID_HMAC_KEY=CHANGE_ME_paste_32plus_random_chars
CRON_SECRET=CHANGE_ME_paste_16plus_random_chars


# ────────────────────────────────────────────────────────────
# [ขั้น 6-7] 🌐 URL ของเว็บไซต์ (Auth.js trusted URL)
# ────────────────────────────────────────────────────────────
# รันในเครื่อง:       http://localhost:3000
# Production (Vercel): https://<ชื่อโปรเจกต์>.vercel.app  (ห้ามมี / ปิดท้าย, ห้ามใช้ localhost)
#
# ⚠️ หลัง deploy ครั้งแรก ต้องกลับมาแก้ค่านี้เป็นลิงก์เว็บจริง แล้ว Redeploy
AUTH_URL=http://localhost:3000


# ────────────────────────────────────────────────────────────
# [ฟีเจอร์รีเซ็ตรหัสผ่าน] 📧 SMTP (ส่งอีเมลรีเซ็ตรหัสผ่านให้เจ้าหน้าที่)
# ────────────────────────────────────────────────────────────
# ใช้โดย src/lib/mail.ts — ใช้ได้กับ SMTP provider ทั่วไป (Resend SMTP, Gmail,
# mail server หน่วยงาน)
#
# ⚠️ สำคัญ: ถ้าไม่ตั้ง SMTP_HOST → อีเมลรีเซ็ตจะ "ไม่ถูกส่ง" แบบเงียบๆ
#    (ระบบจงใจไม่ throw เพื่อกัน enumeration — ดู mail.ts) ทำให้ฟีเจอร์
#    "ลืมรหัสผ่าน" ใช้ไม่ได้จริงใน production โดยไม่มี error แจ้ง
#    → production ต้องตั้ง SMTP_HOST (+ SMTP_USER/SMTP_PASS ถ้า provider ต้อง auth)
#
#   SMTP_HOST  → เช่น smtp.resend.com / smtp.gmail.com (✔ บังคับใน production)
#   SMTP_PORT  → 587 (default, STARTTLS) หรือ 465 (secure) — ปล่อยว่าง = 587
#   SMTP_USER  → username ของ SMTP (ถ้า provider ต้อง authenticate)
#   SMTP_PASS  → password / API key ของ SMTP (คู่กับ SMTP_USER)
#   MAIL_FROM  → ชื่อ+อีเมลผู้ส่ง (ปล่อยว่าง = "Subdistrict Works <no-reply@sw.demo>")
#
# SMTP_HOST=CHANGE_ME_smtp_your_provider_com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME_smtp_username
# SMTP_PASS=CHANGE_ME_smtp_password_or_api_key
# MAIL_FROM="Subdistrict Works <no-reply@sw.demo>"
#
# เฉพาะ dev: ตั้ง MAIL_CONSOLE=true เพื่อ log อีเมลออก console แทนการส่งจริง
# (ไม่ต้องมี SMTP ก็ทดสอบ flow รีเซ็ตได้ในเครื่อง)
# MAIL_CONSOLE=true


# ============================================================
# ✅ Checklist ก่อน deploy (ระบบตรวจสอบอัตโนมัติตอน build)
# ============================================================
#  [✔] ทุกบรรทัดข้างบนถูกแทนด้วยค่าจริงหมดแล้ว (ไม่มี CHANGE_ME_ เหลืออยู่)
#  [✔] AUTH_SECRET  ยาว ≥ 32 ตัวอักษร
#  [✔] CID_HMAC_KEY ยาว ≥ 32 ตัวอักษร
#  [✔] CRON_SECRET  ยาว ≥ 16 ตัวอักษร
#  [✔] UPSTASH_REDIS_REST_TOKEN ยาว ≥ 16 ตัวอักษร
#  [✔] AUTH_URL (production) เป็น https:// และไม่ใช่ localhost
# ============================================================

# ============================================================
# ⏰ Cron Jobs (หลัง deploy แล้ว ตั้งใน cron-job.org ไม่ใช่ Vercel)
# ============================================================
#  4 jobs ที่ต้องสร้างใน https://cron-job.org:
#
#   close-stale      | https://<เว็บ>/api/cron/close-stale      | 0 8 * * *
#   cleanup-hashes   | https://<เว็บ>/api/cron/cleanup-hashes   | 30 8 * * *
#   stats-refresh    | https://<เว็บ>/api/cron/stats-refresh    | 0 9 * * *
#   ping             | https://<เว็บ>/api/cron/ping             | */15 * * * *
#
#  ทุก job ต้องส่ง header:  Authorization: Bearer <CRON_SECRET>
#  (เว็บจะตรวจสอบ — ถ้าไม่ตรงจะคืน 401 Unauthorized)
# ============================================================
